# =========================================================
# Copie para .env e preencha com SUAS credenciais:
#     cp .env.example .env
#
# O arquivo .env esta no .gitignore e NUNCA deve ser commitado.
# Este .example nao contem nenhuma credencial real.
# =========================================================

# Senha do usuario administrativo do Oracle (SYS / SYSTEM)
ORACLE_PWD=troque_esta_senha

# Usuario e senha da aplicacao (criados automaticamente no PDB XEPDB1)
APP_DB_USER=pethub
APP_DB_PASSWORD=troque_esta_senha

# Segredo JWT para autenticacao (minimo 256 bits / 32 caracteres)
JWT_SECRET=troque-este-segredo-com-pelo-menos-32-caracteres-ok

# Comportamento do Hibernate:
#   validate -> confere que o DDL entregue bate com as entidades (padrao)
#   none     -> nao verifica nada
#   update   -> deixa o Hibernate alterar o schema (nao usar na entrega)
SPRING_DDL_AUTO=validate
SPRING_SHOW_SQL=true
SPRING_POOL_MAX=10
SPRING_POOL_MIN=2

# Prefixo obrigatorio das imagens: RM do representante do grupo
IMAGE_PREFIX=rm566234
IMAGE_TAG=v1
